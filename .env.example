# FoodAI Environment Variables
# Copy file này thành .env và điền giá trị thực

ENVIRONMENT=development
AUTH_SECRET_KEY=replace_with_at_least_32_random_characters
AUTH_ISSUER=foodai-api
AUTH_AUDIENCE=foodai-mobile
GOOGLE_WEB_CLIENT_ID=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
TRUST_PROXY_HEADERS=false
VISION_ENABLED=true
CV_ENABLED=true
QDRANT_REQUIRED=true
ENABLE_DEV_ROUTES=true
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_TOKEN=
VISION_MAX_CONCURRENCY=4
EMBEDDING_MAX_CONCURRENCY=8
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_ROOT=data/feedback_objects
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=foodai-feedback
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FEEDBACK_RETENTION_DAYS=90

# OpenCode API (Vision model — thay Gemini)
VISION_API_KEY=your_opencode_api_key_here
VISION_API_BASE=https://opencode.ai/zen/go/v1
VISION_MODEL=qwen3.7-plus

# LLM + Embedding (local llama.cpp)
LLM_URL=http://localhost:8080
EMBEDDING_URL=http://localhost:8081
LLM_MODEL=qwen2.5-7b-instruct-q4_k_m.gguf
EMBEDDING_MODEL=qwen3-embedding-0.6b-q8_0.gguf

# Database
DATABASE_URL=postgresql+asyncpg://foodai:foodai@localhost:5432/foodai

# Qdrant derived vector index
QDRANT_URL=http://localhost:6333
