# FoodAI Environment Variables
# Copy file này thành .env và điền giá trị thực

ENVIRONMENT=development
AUTH_SECRET_KEY=replace_with_at_least_32_random_characters
AUTH_ISSUER=foodai-api
AUTH_AUDIENCE=foodai-mobile
GOOGLE_WEB_CLIENT_ID=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
TRUST_PROXY_HEADERS=false
VISION_ENABLED=true
# EfficientNet/CV was removed from the runtime flow. Old CV_* variables are
# intentionally omitted; pydantic still ignores them in legacy .env files.
QDRANT_REQUIRED=true
ENABLE_DEV_ROUTES=true
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_TOKEN=
VISION_MAX_CONCURRENCY=4
EMBEDDING_MAX_CONCURRENCY=8
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_ROOT=data/feedback_objects
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=foodai-feedback
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FEEDBACK_RETENTION_DAYS=90

# OpenCode API (Vision model — thay Gemini)
VISION_API_KEY=your_opencode_api_key_here
VISION_API_BASE=https://opencode.ai/zen/go/v1
VISION_MODEL=qwen3.5-plus

# LLM + Embedding (local llama.cpp)
LLM_URL=http://localhost:8080
EMBEDDING_URL=http://localhost:8081
LLM_MODEL=qwen2.5-7b-instruct-q4_k_m.gguf
EMBEDDING_MODEL=qwen3-embedding-0.6b-q8_0.gguf

# Database
DATABASE_URL=postgresql+asyncpg://foodai:foodai@localhost:5432/foodai

# Qdrant derived vector index
QDRANT_URL=http://localhost:6333

# Optional Food Gate sidecar. Keep disabled unless its container is running.
# Use `shadow` to observe only; use `enforce` to block confirmed non-food images.
FOOD_GATE_MODE=disabled

# Local image encoders (EfficientNet/SigLIP/DINOv2) are retired from the API
# flow. Do not enable IMAGE_EMBED_* or IMAGE_FAST_LANE_* in a runtime .env.

# Training dataset sync (S3/MinIO)
DATASET_S3_BUCKET=foodai-datasets
DATASET_S3_PREFIX=datasets/train
DATASET_S3_REGION=us-east-1
DATASET_S3_ENDPOINT_URL=http://localhost:9000
DATASET_S3_ACCESS_KEY_ID=foodai_local
DATASET_S3_SECRET_ACCESS_KEY=change-this-local-password
