FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/hf \
    TRANSFORMERS_OFFLINE=1

WORKDIR /app

COPY requirements.cv.lock .
RUN pip install --no-cache-dir -r requirements.cv.lock \
    && groupadd --system foodai \
    && useradd --system --gid foodai --home-dir /app foodai

# The sidecar needs the shared upload validator and the local fine-tuned
# serving module only; training data and evaluation reports stay out of it.
COPY backend ./backend
COPY ml/__init__.py ./ml/__init__.py
COPY ml/inference/siglip_food_v1.py ./ml/inference/siglip_food_v1.py
COPY checkpoints/siglip_food_v1/encoder ./checkpoints/siglip_food_v1/encoder
COPY checkpoints/siglip_food_v1/classifier_head.pt ./checkpoints/siglip_food_v1/classifier_head.pt

RUN chown -R foodai:foodai /app

USER foodai

EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=3s --start-period=45s --retries=3 \
    CMD ["sh", "-c", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:${PORT:-8085}/live', timeout=2)\""]

CMD ["sh", "-c", "exec uvicorn ml.inference.siglip_food_v1:app --host 0.0.0.0 --port ${PORT:-8085}"]
