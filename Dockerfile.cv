FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CV_ENABLED=true

WORKDIR /app

COPY requirements.api.lock requirements.cv.txt ./
RUN pip install --no-cache-dir -r requirements.cv.txt \
    && groupadd --system foodai \
    && useradd --system --gid foodai --home-dir /app foodai

COPY backend ./backend
COPY schemas ./schemas
COPY ml ./ml
COPY checkpoints/best_model.pth checkpoints/best_model.manifest.json ./checkpoints/

RUN mkdir -p /app/data/uploads /app/data/feedback_objects \
    && chown -R foodai:foodai /app

USER foodai

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=2)"]

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
