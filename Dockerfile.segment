FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    U2NET_HOME=/app/models/u2net

WORKDIR /app

COPY requirements.segment.lock .
RUN pip install --no-cache-dir -r requirements.segment.lock \
    && groupadd --system foodai \
    && useradd --system --gid foodai --home-dir /app foodai \
    && mkdir -p /app/models/u2net

COPY ml ./ml

RUN chown -R foodai:foodai /app

USER foodai

EXPOSE 8083

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD ["sh", "-c", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:${PORT:-8083}/health', timeout=2)\""]

CMD ["sh", "-c", "exec uvicorn ml.serving.segment_server:app --host 0.0.0.0 --port ${PORT:-8083}"]
