# FoodAI production environment template
# Copy into your deployment provider's secret/env UI. Do not commit real values.

ENVIRONMENT=production
DEBUG=false
ENABLE_DEV_ROUTES=false
LOG_LEVEL=INFO

# Auth
AUTH_SECRET_KEY=replace_with_at_least_32_random_characters
AUTH_ISSUER=foodai-api
AUTH_AUDIENCE=foodai-mobile
GOOGLE_WEB_CLIENT_ID=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Runtime dependencies
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
QDRANT_URL=https://your-qdrant.example.com
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
TRUST_PROXY_HEADERS=true
QDRANT_REQUIRED=true

# Training dataset sync (S3/MinIO). Use a dedicated bucket/prefix for datasets.
DATASET_S3_BUCKET=foodai-datasets
DATASET_S3_PREFIX=datasets/train
DATASET_S3_REGION=us-east-1
DATASET_S3_ENDPOINT_URL=
DATASET_S3_ACCESS_KEY_ID=replace_with_access_key
DATASET_S3_SECRET_ACCESS_KEY=replace_with_secret_key

# User uploads and feedback images: production uses object storage, not local disk.
OBJECT_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=foodai-feedback
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
FEEDBACK_RETENTION_DAYS=90

# Vision model
VISION_ENABLED=true
VISION_API_KEY=replace_with_vision_api_key
VISION_API_BASE=https://opencode.ai/zen/go/v1
VISION_MODEL=qwen3.5-plus
VISION_MAX_CONCURRENCY=4

# ML sidecar. Food Gate blocks confirmed non-food images; SigLIP only adds
# candidate hints to Vision and remains fail-open when unavailable.
FOOD_GATE_MODE=enforce
FOOD_GATE_URL=https://your-ml-sidecar.example.com
FOOD_GATE_SERVICE_TOKEN=replace_with_shared_sidecar_token
SIGLIP_FOOD_HINT_MODE=hint
SIGLIP_FOOD_HINT_URL=https://your-ml-sidecar.example.com/siglip
SIGLIP_FOOD_HINT_TIMEOUT_SECONDS=1.5
SIGLIP_FOOD_HINT_TOP_K=3
SIGLIP_FOOD_HINT_MIN_SCORE=0.90

SEGMENT_ENABLED=false

# LLM / embedding sidecars. Set real service URLs when enabling chat or Qdrant
# semantic fallback in production.
LLM_URL=https://your-llm-service.example.com
LLM_MODEL=qwen2.5-7b-instruct-q4_k_m.gguf
EMBEDDING_URL=https://your-embedding-service.example.com
EMBEDDING_MODEL=qwen3-embedding-0.6b-q8_0.gguf
EMBEDDING_MAX_CONCURRENCY=8

# Observability
METRICS_ENABLED=true
METRICS_TOKEN=replace_with_at_least_32_random_characters
