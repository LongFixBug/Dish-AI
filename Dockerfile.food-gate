FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/hf

WORKDIR /app

COPY requirements.cv.lock .
RUN pip install --no-cache-dir -r requirements.cv.lock

RUN python -c "from transformers import AutoConfig, AutoImageProcessor; model = 'google/siglip2-base-patch16-224'; AutoConfig.from_pretrained(model); AutoImageProcessor.from_pretrained(model)" \
    && groupadd --system foodai \
    && useradd --system --gid foodai --home-dir /app foodai

COPY backend ./backend
COPY ml ./ml
COPY checkpoints/food_gate/siglip2_food_gate_best.pt ./checkpoints/food_gate/siglip2_food_gate_best.pt

RUN chown -R foodai:foodai /app

USER foodai

EXPOSE 8084

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8084/live', timeout=2)"]

CMD ["uvicorn", "ml.inference.food_gate:app", "--host", "0.0.0.0", "--port", "8084"]
